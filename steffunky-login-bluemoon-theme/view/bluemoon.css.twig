h1 {
    font-size: 2rem;
    color: var(--ils-color-blue-grey-800);
    margin-bottom: 8px;
}

a {
    color: var(--ils-color-blue-600)
}

a:hover {
    color: var(--ils-color-blue-800)
}

a:hover {
    color: var(--ils-color-blue-700)
}

#login-body {
    background-color: var(--ils-color-white-150);
    color: var(--ils-color-blue-grey-900);
}

#login-content {
    border: none;
    box-shadow: var(--ils-elevation-100);
    border-radius: 12px;
    padding: 24px;
}

#login-form-content {
    display: flex;
    flex-direction: column;
    padding: 0 16px;
}

.hilite {
    color: var(--ils-color-red-700)
}

#login-title, #login-form-content > div {
    width: auto;
    margin-left: 0;
}

#login-sso-buttons {
     padding: 0;
}

.sso-button {
    background-color: var(--ils-color-blue-100);
    color: var(--ils-color-blue-800);
    filter: none;
    font-size: 1.17rem;
    padding: 8px 0.5rem;
    border-radius: 5px;
}

.sso-button:hover {
    background-color: var(--ils-color-blue-200);
}

.sso-button .hybridauth-logo {
    color: var(--ils-color-blue-800);
}

#login-form-content .divider hr {
    background-color: var(--ils-color-blue-grey-400);
}

.ibo-input {
    height: 32px;
    width: calc(100% - 20px);
    border-color: var(--ils-color-blue-grey-400);
    border-radius: 5px;
}

#login-input label {
    font-weight: 600;
}

#login-input > div {
    margin-top: 16px;
}

label + input {
    margin-left: 0;
}

#login-submit input, #forgot_pwd_sent input {
    background-color: var(--ils-color-blue-grey-700);
    color: var(--ils-color-white-100);
    border-radius: 8px;
    padding: 4px 0;
    font-weight: 500;
    font-size: 1.17rem;
}

#login-submit input.login-submit-secondary, #forgot_pwd_sent input.forgot_pwd_done {
    background-color: var(--ils-color-blue-grey-100);
    color: var(--ils-color-blue-grey-900);
}

